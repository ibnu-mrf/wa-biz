# ==========================================
# WABiz WhatsApp Staging Worker - Environment Configuration
# ==========================================
# CATATAN: File ini hanya template contoh tanpa nilai secret nyata.
# Salin file ini menjadi .env sebelum menjalankan worker secara lokal.
# JANGAN gunakan nomor produksi atau nomor utama lembaga!

# Server Network (Bind strictly to localhost loopback for local security)
HOST=127.0.0.1
PORT=4000

# Local API Authentication (Wajib diisi untuk memanggil endpoint lokal /send, /status, /qr)
LOCAL_API_KEY=ganti_dengan_token_rahasia_lokal_minimal_16_karakter

# Storage Sesi Baileys (Folder lokal terisolasi, diabaikan oleh .gitignore)
SESSION_DIR=./sessions

# Tampilkan QR di terminal interaktif untuk pairing manual lokal
SHOW_TERMINAL_QR=true

# Pengaturan Rekoneksi Otomatis (Backoff Terbatas)
MAX_RECONNECT_RETRIES=5
INITIAL_RECONNECT_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=30000

# Origins Development yang diizinkan untuk CORS (pisahkan dengan koma jika lebih dari satu)
# Default otomatis mencakup http://localhost:8081 dan http://127.0.0.1:8081
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Level Log Pino (silent, error, warn, info, debug)
# Disarankan 'info' atau 'warn' agar tidak mencetak payload mentah
LOG_LEVEL=info

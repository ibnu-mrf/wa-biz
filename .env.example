# ==========================================
# WABiz Environment Variables Template (.env.example)
# ==========================================
# Salin file ini menjadi .env dan masukkan kunci publishable Supabase Anda.
# PENTING:
# 1. HANYA gunakan Project URL dan Publishable Key (Anon Key) di sisi klien Expo.
# 2. JANGAN PERNAH memasukkan secret key, service_role key, atau database password di sini!

EXPO_PUBLIC_SUPABASE_URL=https://kjvzqlznnnmltwxsuyda.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# Opsional: WhatsApp Staging Worker (Pengembangan & Staging Lokal Saja)
# Default loopback URL: http://127.0.0.1:4000
# Autentikasi ke worker sepenuhnya menggunakan JWT pengguna Supabase (Authorization: Bearer <token>).
# Kunci rahasia backend (LOCAL_API_KEY) TIDAK BOLEH ditaruh di sini agar tidak bocor ke bundle Expo.
EXPO_PUBLIC_WHATSAPP_WORKER_URL=http://127.0.0.1:4000

